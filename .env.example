# Copy this file to .env and fill in values. Do not commit .env or passwords.

# SUPABASE DATABASE — required for the backend and migration destination.
# Paste the PostgreSQL URI from Supabase > Connect > Session pooler (port 5432).
# Use the database password, not a Supabase API key. URL-encode password characters.
# Example format (replace every placeholder):
# postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# If a custom CA is required, append &sslrootcert=URL_ENCODED_ABSOLUTE_CERT_PATH.
DATABASE_URL=

# EXISTING DATABASE — optional, only used if copying an old database.
# Use the source PostgreSQL connection string. Keep it separate from above.
SOURCE_DATABASE_URL=

# SUPABASE AUTH AND STORAGE — Dashboard > Settings > API Keys.
# Project URL format: https://PROJECT_REF.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never put this key in client code or a VITE_ variable.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=service-images
# Enable each option only after configuring that provider in Supabase Auth.
# OAuth client IDs/secrets belong in Supabase, not in frontend variables.
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_FACEBOOK_ENABLED=false
SUPABASE_APPLE_ENABLED=false
# Microsoft is named Azure in the Supabase provider configuration.
SUPABASE_MICROSOFT_ENABLED=false

# APPLICATION — register APP_URL/api/callback in Supabase Auth redirect URLs.
# Use your HTTPS application URL in production. Use this origin to open locally.
APP_URL=http://localhost:5000
PORT=5000
# PRIVACY POLICY — intentionally public details rendered at build/dev-server start.
# Fill these before submitting /privacy-policy.html to Meta. Rebuild after changes.
PRIVACY_POLICY_OPERATOR_NAME=
PRIVACY_POLICY_OPERATOR_ADDRESS=
PRIVACY_POLICY_EMAIL=
# HTTPS origin only, e.g. https://your-domain.example (no path/query/credentials).
PRIVACY_POLICY_PUBLIC_ORIGIN=
# Optional: replace the general retention/transfer text with verified arrangements.
PRIVACY_POLICY_RETENTION=
PRIVACY_POLICY_INTERNATIONAL_TRANSFERS=
# At least 32 random characters. Changing it invalidates signed login cookies.
SESSION_SECRET=
# DOCKER PRODUCTION — hostname only (no scheme/path/port); Compose derives APP_URL.
# Leave empty for native development or compose.dev.yaml.
APP_DOMAIN=
ACME_EMAIL=
# Optional: immutable registry image tag/digest for releases; defaults to local build.
# APP_IMAGE=ghcr.io/your-organization/fitsmytime:release-tag
# Development host port; also update APP_URL and Supabase redirect URLs if changed.
DEV_PORT=5000
# Comma-separated Supabase Auth user IDs allowed to use App Administration.
# Keep empty to disable support access. Company administrators do not qualify.
APP_ADMIN_USER_IDS=

# AUDIT — development only; keep capture/worker dormant until runtime grants,
# protected private config handoff and database behavioral rehearsal are verified.
# App .env contains only restricted app DATABASE_URL + capture URL, never setup
# owner or worker credentials. Worker connections belong in .env.audit-worker.local.
AUDIT_ENABLED=false
# Enable only after the service-view R90 DB extension and updated worker readiness.
AUDIT_SERVICE_VIEWS_ENABLED=false
# Remote Auth producers are staged until TASK-015 durable intent/reconciliation.
# The reserved true value is rejected; local atomic capture/denials are separate.
AUDIT_AUTH_EVENTS_ENABLED=false
AUDIT_WORKER_ENABLED=false
AUDIT_ENVIRONMENT=development
# Restricted source login fmt_audit_capture_dev; strict TLS, optional sslrootcert.
AUDIT_CAPTURE_DATABASE_URL=
# Worker-only settings below: restricted fmt_audit_worker_dev on source and
# fmt_audit_writer_dev on the independent audit project. Never use postgres owner.
AUDIT_SOURCE_DATABASE_URL=
AUDIT_DATABASE_URL=

# GOOGLE MAPS — browser key, restricted to your website origins.
GOOGLE_MAPS_API_KEY=
# Server-only key for Geocoding API, restricted to the backend's outbound IPs.
# Do not put this key in client code. A website-restricted key will be rejected.
GOOGLE_GEOCODING_API_KEY=

# SEMANTIC SEARCH — required by the current backend's embedding client at startup.
OPENAI_API_KEY=

# Stripe sandbox preparation only. Copy ONLY this section into root .env.stripe.local.
# The billing implementation is currently injected/configuration-only: these names
# are proposed for future bootstrap and are NOT automatically consumed or activated.
STRIPE_BILLING_MODE=test
STRIPE_BILLING_ENABLED=false
STRIPE_NEW_CHECKOUTS_ENABLED=false
# Server-side restricted sandbox API key (rk_test_...); leave blank until configured.
STRIPE_BILLING_API_KEY=
# Sandbox merchant account identifier (acct_...).
STRIPE_BILLING_ACCOUNT_ID=
# Add later, after an approved webhook endpoint is actually provided (whsec_...).
STRIPE_BILLING_WEBHOOK_SECRET=
# Add later, after the reviewed sandbox portal configuration exists (bpc_...).
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Add later: approved HTTPS application origin only, with no path/query/trailing slash.
STRIPE_BILLING_RETURN_ORIGIN=

# Explicit local-app sandbox integration: config/stripe-local-app.env.example
# uses a separate ignored .env.stripe-app.local. Ordinary startup stays disabled.

# NOTIFICATIONS — server-only setup: config/notifications.env.example and
# docs/notifications-setup.md. Migration/runtime activation must precede rollout.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_AUTOMATION_ENABLED=false
NOTIFICATIONS_VERIFICATION_ENABLED=false
# Optional Compose worker input: explicit approved app-runtime login with strict
# TLS and fm_app_runtime membership. Never owner, browser or audit credentials.
# NOTIFICATIONS_DATABASE_URL=
