# Copy this file to .env and fill in values. Do not commit .env or passwords.

# SUPABASE DATABASE — required for the backend and migration destination.
# Paste the PostgreSQL URI from Supabase > Connect > Session pooler (port 5432).
# Use the database password, not a Supabase API key. URL-encode password characters.
# Example format (replace every placeholder):
# postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# If a custom CA is required, append &sslrootcert=URL_ENCODED_ABSOLUTE_CERT_PATH.
DATABASE_URL=

# EXISTING DATABASE — optional, only used if copying an old database.
# Use the source PostgreSQL connection string. Keep it separate from above.
SOURCE_DATABASE_URL=

# SUPABASE AUTH AND STORAGE — Dashboard > Settings > API Keys.
# Project URL format: https://PROJECT_REF.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never put this key in client code or a VITE_ variable.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=service-images
# Enable each option only after configuring that provider in Supabase Auth.
# OAuth client IDs/secrets belong in Supabase, not in frontend variables.
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_FACEBOOK_ENABLED=false
SUPABASE_APPLE_ENABLED=false
# Microsoft is named Azure in the Supabase provider configuration.
SUPABASE_MICROSOFT_ENABLED=false

# APPLICATION — register APP_URL/api/callback in Supabase Auth redirect URLs.
# Use your HTTPS application URL in production. Use this origin to open locally.
APP_URL=http://localhost:5000
PORT=5000
# At least 32 random characters. Changing it invalidates signed login cookies.
SESSION_SECRET=
# Comma-separated Supabase Auth user IDs allowed to use App Administration.
# Keep empty to disable support access. Company administrators do not qualify.
APP_ADMIN_USER_IDS=

# GOOGLE MAPS — browser key, restricted to your website origins.
GOOGLE_MAPS_API_KEY=
# Server-only key for Geocoding API, restricted to the backend's outbound IPs.
# Do not put this key in client code. A website-restricted key will be rejected.
GOOGLE_GEOCODING_API_KEY=

# SEMANTIC SEARCH — required by the current backend's embedding client at startup.
OPENAI_API_KEY=
