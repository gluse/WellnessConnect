# TASK-032: server-only example; no real sends until explicitly enabled.
# Apply the reviewed notifications migrations and runtime grants first.
# Do not put any of these secrets in VITE_* variables.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_AUTOMATION_ENABLED=false
NOTIFICATIONS_VERIFICATION_ENABLED=false

# Existing authorized app-runtime database configuration is used by the worker.
# Never use the restricted audit-worker connection or a browser/service-role key.
# DATABASE_URL=

VONAGE_APPLICATION_ID=
# PEM as a secret environment value; escaped \n is supported.
VONAGE_PRIVATE_KEY=
VONAGE_API_KEY=
VONAGE_SIGNATURE_SECRET=
# SMS sender must support inbound opt-out messages in the target countries.
VONAGE_SMS_FROM=
# WhatsApp Business number, international digits without +.
VONAGE_WHATSAPP_FROM=
# Only approved templates. Map every enabled customer language/action explicitly.
# Body parameters: service name, new date/time with timezone, old date/time
# (third parameter only for rescheduled). No channel/language fallback.
VONAGE_WHATSAPP_TEMPLATES_JSON={}
# Example value (replace with your own approved template metadata):
# {"en:accepted":{"namespace":"YOUR_NAMESPACE","name":"booking_accepted","language":"en"}}

RESEND_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
NOTIFICATIONS_RESEND_WEBHOOK_SECRET=
# Configure raw signed callbacks:
# POST https://YOUR_APP/api/notifications/webhooks/vonage (Messages status + inbound)
# POST https://YOUR_APP/api/notifications/webhooks/resend
