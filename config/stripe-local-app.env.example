# Copy to .env.stripe-app.local only after the documented database/startup scope is approved.
# Never commit real values. Keep .env.stripe.local preparation flags false and mode test.
STRIPE_LOCAL_APP_ENABLED=false
STRIPE_LOCAL_TEST_ACK=SANDBOX_ONLY_NO_REAL_PURCHASES
# Explicit DB-owner-approved fmt_app_dev development connection; no inherited DATABASE_URL fallback.
STRIPE_LOCAL_DATABASE_URL=
STRIPE_LOCAL_CHECKOUTS_ENABLED=false
STRIPE_LOCAL_WORKER_ENABLED=false
STRIPE_LOCAL_ORIGIN=http://localhost:5000
